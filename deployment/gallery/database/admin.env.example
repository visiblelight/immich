# One-shot commands only. Keep the real file in .gallery-local, chmod 600.
# Never pass this file to gallery-public or gallery-admin services.
GALLERY_BOOTSTRAP_DATABASE_URL=
# Existing Immich DB login whose ability to run future upstream migrations is preserved.
GALLERY_IMMICH_DATABASE_ROLE=
GALLERY_MIGRATION_DATABASE_URL=
GALLERY_MIGRATOR_PASSWORD=
GALLERY_ADMIN_PASSWORD=
GALLERY_PUBLIC_PASSWORD=
