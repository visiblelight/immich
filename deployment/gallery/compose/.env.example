# Copy outside version control. Every file path must be absolute.
GALLERY_IMAGE=gallery:local
IMMICH_NETWORK=immich_default
GALLERY_THUMBS_PATH=/srv/immich/thumbs
GALLERY_PUBLIC_ENV_FILE=/srv/gallery/secrets/public.env
GALLERY_ADMIN_ENV_FILE=/srv/gallery/secrets/admin.env
GALLERY_PUBLIC_ORIGIN=https://gallery.example.com
GALLERY_ADMIN_ORIGIN=https://gallery-admin.example.com
GALLERY_PUBLIC_PORT=3200
GALLERY_ADMIN_PORT=3201

# Independent Gallery article media; create with node uid 1000 write permission.
GALLERY_ARTICLE_MEDIA_PATH=/srv/gallery/article-media
