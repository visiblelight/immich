# Copy outside the checkout and chmod 600; generate independent production secrets.
VISION_DATA_ROOT=/srv/vision/data
VISION_EDGE_NETWORK=vision-edge
IMMICH_NETWORK=vision-data
IMMICH_ENV_FILE=/srv/vision/secrets/immich.env
DB_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
IMMICH_ML_IMAGE=ghcr.io/immich-app/immich-machine-learning@sha256:REPLACE_WITH_VERIFIED_DIGEST
GALLERY_IMAGE=gallery:REPLACE_WITH_COMMIT
GALLERY_PUBLIC_ENV_FILE=/srv/vision/secrets/public.env
GALLERY_ADMIN_ENV_FILE=/srv/vision/secrets/admin.env
GALLERY_PUBLIC_ORIGIN=https://vision.ke
GALLERY_ADMIN_ORIGIN=https://admin.vision.ke
GALLERY_PUBLIC_PORT=3200
GALLERY_ADMIN_PORT=3201
GALLERY_THUMBS_PATH=/srv/vision/data/library/thumbs
GALLERY_ARTICLE_MEDIA_PATH=/srv/vision/data/articles
