{
  "Version": "1",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "alidns:DescribeDomainRecords",
        "alidns:AddDomainRecord",
        "alidns:DeleteDomainRecord"
      ],
      "Resource": ["acs:alidns:*:*:domain/acme-cdn.ke.ink"]
    },
    {
      "Effect": "Allow",
      "Action": ["cdn:SetCdnDomainSSLCertificate"],
      "Resource": ["acs:cdn:*:*:domain/cdn.ke.ink"]
    }
  ]
}
