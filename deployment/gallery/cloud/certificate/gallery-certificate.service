[Unit]
Description=Gallery CDN Let's Encrypt renewal and deployment
Wants=network-online.target
Requires=gallery-metadata-guard.service
After=network-online.target gallery-metadata-guard.service

[Service]
Type=oneshot
User=gallery-certificate
Group=gallery-certificate
ExecStart=/opt/gallery-certificate/run.sh renew
TimeoutStartSec=45min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/gallery-certificate
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
LockPersonality=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
