[Unit]
Description=Synchronize published Gallery media to private OSS
Requires=gallery-metadata-guard.service
After=docker.service network-online.target gallery-metadata-guard.service

[Service]
Type=oneshot
ExecStart=/opt/gallery-media/venv/bin/python /opt/gallery-media/sync.py
UMask=0027
TimeoutStartSec=30min
Nice=10
MemoryMax=768M
CPUQuota=50%
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/gallery-media
