# Copy only the relevant settings to each service; do not share privileged credentials.
GALLERY_PUBLIC_ORIGIN=http://127.0.0.1:3100
GALLERY_ADMIN_ORIGIN=http://127.0.0.1:3101
IMMICH_ORIGIN=http://127.0.0.1:3000

# Phase B provides migrations and isolated verification; apply during deployment.
# Intentionally empty: no implicit database owner credentials or source scope.
GALLERY_PUBLIC_DATABASE_URL=
GALLERY_ADMIN_DATABASE_URL=

# Public service receives read-only access to derived images only.
# No database connection or filesystem mount is opened by the phase A skeleton.
GALLERY_MEDIA_SOURCE_ROOT=
GALLERY_MEDIA_ROOT=
GALLERY_MEDIA_CACHE=

# Runtime service-specific configuration for adapter-node:
# HOST=127.0.0.1
# PORT=3100 (public) or 3101 (admin)
# ORIGIN must equal the service's trusted external origin.
