# adapter-node runtime; use the matching gallery_public database role.
HOST=127.0.0.1
PORT=3100
ORIGIN=http://127.0.0.1:3100
GALLERY_PUBLIC_ORIGIN=http://127.0.0.1:3100
GALLERY_ADMIN_ORIGIN=http://localhost:3101
GALLERY_DATABASE_URL=
# DB derivative paths must be under SOURCE_ROOT; only mount the corresponding thumbs directory.
GALLERY_MEDIA_SOURCE_ROOT=/data/thumbs
GALLERY_MEDIA_MOUNTED_ROOT=
# Opt-in sample design pages only; no database content.
GALLERY_DESIGN_PREVIEW=0

# Shared 32-byte hex encryption key for Amap security code; generate once, back up separately.
# Set the same value in public/admin runtime env files; never expose it in browser config.
GALLERY_MAP_SECRET_KEY=

# Independent article uploads; public reads, admin writes. Use an absolute path.
GALLERY_ARTICLE_MEDIA_ROOT=

# Optional visitor accounts. Must use gallery_community, never owner/admin/migrator.
GALLERY_COMMUNITY_DATABASE_URL=
GALLERY_MEMBER_CODE_SECRET=
GALLERY_MAIL_ACCESS_KEY_ID=
GALLERY_MAIL_ACCESS_KEY_SECRET=
GALLERY_MAIL_FROM=vision@ke.ink
GALLERY_MAIL_ALIAS=光与远方
