{
  "name": "immich-monorepo",
  "version": "3.2.0",
  "description": "Monorepo for Immich",
  "type": "module",
  "private": true,
  "scripts": {
    "gallery:map:generate": "node packages/gallery-public/scripts/generate-world-map.mjs",
    "gallery:map:boundaries": "node packages/gallery-db/scripts/prepare-countries.ts",
    "gallery:local:init": "node packages/gallery-db/scripts/initialize-local.ts",
    "gallery:local:public": "node --env-file=.gallery-local/runtime/public.env packages/gallery-public/build/index.js",
    "gallery:local:admin": "node --env-file=.gallery-local/runtime/admin.env packages/gallery-admin/build/index.js",
    "gallery:doctor": "node deployment/gallery/scripts/doctor.mjs",
    "gallery:check": "pnpm --filter '@gallery/*' -r run check",
    "gallery:build": "pnpm --filter '@gallery/*' -r run build",
    "gallery:test": "pnpm --filter '@gallery/*' -r --if-present run test",
    "gallery:dev:public": "pnpm --filter @gallery/public dev",
    "gallery:dev:admin": "pnpm --filter @gallery/admin dev",
    "gallery:smoke": "node deployment/gallery/scripts/smoke.mjs",
    "format": "prettier --cache --check i18n/",
    "format:fix": "prettier --cache --write --list-different i18n",
    "gallery:test:db": "node deployment/gallery/scripts/database-check.mjs",
    "gallery:db": "node packages/gallery-db/scripts/database.ts",
    "gallery:prepare:db-tests": "node deployment/gallery/scripts/prepare-database-check.mjs",
    "gallery:design:admin": "GALLERY_DESIGN_PREVIEW=1 pnpm --filter @gallery/admin dev",
    "gallery:design": "GALLERY_DESIGN_PREVIEW=1 pnpm --filter @gallery/public dev",
    "gallery:account": "node packages/gallery-db/scripts/account.ts",
    "gallery:prepare:upgrade": "node deployment/gallery/scripts/prepare-upgrade-check.mjs",
    "gallery:upgrade:prepare-copy": "node deployment/gallery/upgrade/prepare-copy.mjs",
    "gallery:upgrade:verify": "node deployment/gallery/upgrade/verify-flow.mjs",
    "gallery:upgrade:rollback": "node deployment/gallery/upgrade/verify-rollback.mjs"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "pnpm": ">=10.0.0"
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "prettier-plugin-sort-json": "^4.2.0"
  }
}
